# ---------------------------------------------------------------------------
# Environment for the Docker Compose production stack (docker-compose.yml).
# Copy this file to ".env" in the same directory and fill in real values:
#
#   cp .env.production.example .env
#
# This is separate from the repo's ".env.example" (which is for running
# `npm run dev` directly on a machine, DB_HOST=localhost). Inside Docker, the
# app talks to Postgres over the compose network using the service name
# "postgres" — never "localhost" — see DATABASE_URL below.
#
# NEVER commit the resulting ".env" file (.gitignore already excludes it).
# ---------------------------------------------------------------------------

# --- PostgreSQL ---
# DB_HOST/DB_PORT are informational only here (e.g. for a manual `docker
# compose exec postgres psql ...`); the values that matter are DB_USERNAME/
# DB_PASSWORD/DB_DATABASE (docker-compose.yml maps them to the postgres
# container's POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB) and DATABASE_URL
# (read directly by Prisma).
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=fiship
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_DATABASE=e_commerce
DB_SCHEMA=fiship

# Host MUST be the Docker Compose service name "postgres", not localhost/127.0.0.1.
DATABASE_URL="postgresql://fiship:CHANGE_ME_STRONG_PASSWORD@postgres:5432/e_commerce?schema=fiship"

# Sealed session cookie secret for nuxt-auth-utils (min 32 chars). Generate with:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
NUXT_SESSION_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Cloudflare R2 (S3-compatible object storage) for admin-uploaded images
# (server/utils/r2.ts, server/services/upload.service.ts). Required — the
# app throws on startup use if these are missing.
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=YOUR_BUCKET_NAME

# Public site URL (used by @nuxtjs/sitemap). Set to your real https domain —
# Nginx is expected to terminate TLS in front of this stack.
NUXT_PUBLIC_SITE_URL=https://canhabien.vn

# Host-side port docker-compose publishes to 127.0.0.1 (see docker-compose.yml
# "app.ports"). This is what your host Nginx reverse-proxies to. Change only
# if 3000 is already taken on the host.
APP_PORT=3000
