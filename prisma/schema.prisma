// Prisma schema for Fiship — website bán cá tươi
// docs: https://pris.ly/d/prisma-schema

// moduleFormat = "cjs": avoids import.meta.url, which Nitro's production
// bundle mishandles on Windows for inlined first-party ESM modules (see
// https://github.com/nitrojs/nitro — Windows file:// URL resolution).
generator client {
  provider     = "prisma-client"
  output       = "../server/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPING
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
  VNPAY
  MOMO
  ZALOPAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum PostType {
  NEWS
  RECIPE
}

enum SuggestedDishVideoType {
  YOUTUBE
  MP4
  OTHER
}

// ---------------------------------------------------------------------------
// User & Address
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         Role      @default(CUSTOMER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  addresses Address[]
  orders    Order[]
  cart      Cart?
  reviews   Review[]
  wishlists Wishlist[]

  @@index([role])
  @@map("users")
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  fullName    String
  phone       String
  province    String
  district    String
  ward        String
  addressLine String
  note        String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  imageUrl      String?
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  /// Số sản phẩm tối đa hiển thị ở landing page cho danh mục này trước khi ẩn
  /// và hiện nút "Xem tất cả" — null nghĩa là hiển thị toàn bộ sản phẩm.
  homepageLimit Int?
  position      Int      @default(0)
  /// Thứ tự sắp xếp mặc định khi hiển thị sản phẩm của danh mục này (trang chủ
  /// và trang danh mục) — cùng bộ giá trị với `sort` của GET /api/products,
  /// xem CategoryDefaultSort ở category.schema.ts.
  defaultSort   String   @default("newest")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products Product[]

  @@index([slug])
  @@map("categories")
}

model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  origin      String?
  status      ProductStatus @default(ACTIVE)
  isFeatured  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  /// Snapshot của giá biến thể mặc định (isDefault=true), do product.service
  /// đồng bộ mỗi khi variants thay đổi — dùng để filter/sort theo giá ở danh
  /// sách sản phẩm mà không cần order-by trên quan hệ 1-nhiều trong Prisma.
  price          Decimal? @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)

  /// Tổng tồn kho của mọi biến thể, do product.service đồng bộ mỗi khi variants
  /// thay đổi và order.service giảm cùng lúc với stock của variant khi tạo đơn —
  /// mirror của pattern price-sync ở trên, dùng để sort theo tồn kho ở danh sách
  /// sản phẩm mà không cần order-by/sum trên quan hệ 1-nhiều trong Prisma.
  stock Int @default(0)

  /// Tổng số lượng đã bán thành công, cộng dồn khi order được tạo — dùng cho
  /// mục "Cá bán chạy" ở trang chủ và thống kê admin.
  soldCount Int @default(0)

  /// Đồng bộ bởi review.service khi review được tạo/sửa/ẩn/xoá — mirror của
  /// pattern price-sync ở trên, tránh phải aggregate quan hệ 1-nhiều mỗi lần
  /// hiển thị danh sách sản phẩm.
  avgRating   Float @default(0)
  reviewCount Int   @default(0)

  categories      Category[]
  images          ProductImage[]
  variants        ProductVariant[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  reviews         Review[]
  wishlists       Wishlist[]
  tags            Tag[]
  suggestedDishes SuggestedDish[]
  sourcingOptions ProductSourcingOption[]

  @@index([slug])
  @@index([status])
  @@index([price])
  @@index([soldCount])
  @@index([stock])
  @@map("products")
}

/// Món ăn gợi ý gắn với một sản phẩm (vd sản phẩm "Cá ngừ" gợi ý món "Cá ngừ áp
/// chảo") — quản lý ngay trong trang Sửa sản phẩm admin, không có trang riêng.
/// Chỉ 1 ảnh/món (giống Banner.imageUrl) vì UI chỉ cần 1 ảnh đại diện cho mỗi
/// món, không cần một bảng ảnh con như ProductImage. videoUrl là link ngoài
/// (YouTube/MP4) — không upload file video, videoType được suy ra tự động từ
/// URL khi lưu (xem detectVideoType ở shared/utils/video.ts).
model SuggestedDish {
  id        String                  @id @default(cuid())
  productId String
  name      String
  imageUrl  String?
  videoUrl  String?
  videoType SuggestedDishVideoType?
  position  Int                     @default(0)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("suggested_dishes")
}

/// Phân loại nguồn cá tuỳ chỉnh cho một sản phẩm (vd "Có sẵn", "Theo mùa/chuyến",
/// "Đặc biệt") — quản lý ngay trong trang Sửa sản phẩm admin, cùng pattern với
/// SuggestedDish (sync theo id, không có trang riêng). Đây chỉ là dữ liệu mô tả/
/// logistics (KHÔNG có giá riêng — giá bán vẫn luôn là ProductVariant.price, để
/// tránh 2 nơi cùng khai báo giá gây nhầm lẫn); depositPercent là % dự kiến hiển
/// thị cho khách/admin tham khảo, không trừ vào Payment.amount nào cả — xem
/// order.service.ts#attemptCreateOrder (Order.depositPercent/estimatedAvailabilityDays).
model ProductSourcingOption {
  id        String   @id @default(cuid())
  productId String
  label     String
  /// Mô tả quy trình lấy cá (vd đánh bắt, thời điểm ra khơi...)
  catchProcess String? @db.Text
  /// Thời gian dự kiến có cá — chuỗi tự do (vd "3-5 ngày sau khi đặt cọc") vì
  /// phụ thuộc thời tiết/chuyến đi, không phải một khoảng thời gian cố định.
  expectedAvailability String?
  /// Số ngày dự kiến (vd 5, ứng với vế dài nhất của expectedAvailability) — nhập
  /// tay riêng vì expectedAvailability là chuỗi tự do không thể suy luận số ra
  /// được. Dùng để so sánh/tính Order.estimatedAvailabilityDays khi tạo đơn
  /// (order.service.ts#attemptCreateOrder), không hiển thị trực tiếp cho khách.
  expectedAvailabilityDays Int?
  /// % cọc trước, 0-100 — null nghĩa là không yêu cầu cọc.
  depositPercent Int?
  position Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_sourcing_options")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

/// Đơn vị bán (unit) là chuỗi tự do (vd "kg", "con", "hộp", "500g") để có thể
/// mở rộng thêm đơn vị mới mà không cần migration enum.
model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  unit           String
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  stock          Int      @default(0)
  sku            String?  @unique
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

/// Quick-filter chip gắn cho sản phẩm (vd "Cá fillet", "Làm sẵn nướng BBQ") —
/// admin tự tạo và gắn tag, không có dữ liệu mặc định.
model Tag {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  color       String   @default("#6B7280")
  showOnImage Boolean  @default(false)
  createdAt   DateTime @default(now())

  products Product[]

  @@index([slug])
  @@map("tags")
}

// ---------------------------------------------------------------------------
// Cart
// ---------------------------------------------------------------------------

model Cart {
  id        String   @id @default(cuid())
  userId    String?  @unique
  sessionId String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  userId        String?
  status        OrderStatus   @default(PENDING)
  subtotal      Decimal       @db.Decimal(12, 2)
  shippingFee   Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(PENDING)

  /// Tổng giảm giá từ mọi mã giảm giá đã áp dụng — snapshot bằng tổng discountAmount
  /// của các OrderCoupon con (một khách chỉ áp được tối đa 1 mã/danh mục mã giảm
  /// giá nhưng có thể áp nhiều mã ở nhiều danh mục khác nhau cùng lúc), tính một
  /// lần khi tạo đơn, mirror của pattern denormalize Product.stock.
  discountAmount Decimal @default(0) @db.Decimal(12, 2)

  /// % cọc cao nhất trong số ProductSourcingOption của mọi sản phẩm trong đơn —
  /// null/0 nghĩa là không có sản phẩm nào cần cọc. Tính một lần khi tạo đơn
  /// (order.service.ts#attemptCreateOrder), chỉ là cờ đánh dấu để admin/khách
  /// biết cần liên hệ xác nhận cọc — KHÔNG tự động đổi Payment.amount, đơn vẫn
  /// thu đủ total như bình thường (chưa có luồng thanh toán một phần).
  depositPercent Int?

  /// Số ngày dự kiến giao hàng dài nhất trong số ProductSourcingOption.expectedAvailabilityDays
  /// của mọi sản phẩm trong đơn — null nghĩa là không sản phẩm nào khai báo. Cùng
  /// pattern denormalize-tại-thời-điểm-tạo-đơn như depositPercent ở trên.
  estimatedAvailabilityDays Int?

  // Snapshot thông tin giao hàng tại thời điểm đặt (độc lập với Address gốc)
  recipientName  String
  recipientPhone String
  province       String
  district       String
  ward           String
  addressLine    String
  note           String?
  addressId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?         @relation(fields: [userId], references: [id])
  address  Address?      @relation(fields: [addressId], references: [id])
  items    OrderItem[]
  coupons  OrderCoupon[]
  payment  Payment?
  shipping Shipping?
  reviews  Review[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

/// Một đơn hàng có thể áp nhiều mã giảm giá cùng lúc, tối đa 1 mã cho mỗi
/// CouponCategory (ép buộc ở order.service.ts#attemptCreateOrder, không phải ở
/// DB) — bảng nối này lưu từng mã đã áp cho một đơn, tách khỏi Coupon để giữ
/// snapshot mã/giá trị giảm tại thời điểm đặt hàng.
model OrderCoupon {
  id             String  @id @default(cuid())
  orderId        String
  couponId       String?
  couponCode     String // snapshot of the code used, independent of the Coupon row's current code
  discountAmount Decimal @db.Decimal(12, 2)

  order  Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  coupon Coupon? @relation(fields: [couponId], references: [id])

  @@index([orderId])
  @@map("order_coupons")
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  variantId   String
  productName String
  unit        String
  price       Decimal @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal @db.Decimal(12, 2)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String        @unique
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  amount        Decimal       @db.Decimal(12, 2)
  /// Mã tham chiếu tuỳ chọn: "sepay:<id giao dịch>" khi webhook SePay tự xác
  /// nhận (xem confirmBankTransferPaymentFromSepay), null khi admin xác nhận
  /// thủ công (confirmBankTransferPayment) — chỉ để tra cứu, không dùng để
  /// chống trùng (chống trùng nằm ở guard PENDING->PAID trong settlePayment).
  transactionId String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  /// Snapshot thông tin ngân hàng (từ Setting) tại thời điểm tạo đơn — QR VietQR
  /// hiển thị cho khách luôn dựng từ snapshot này (server/utils lẫn app/utils
  /// đều đọc từ đây), không đọc lại Setting hiện tại, để đơn cũ không bị đổi
  /// tài khoản nhận tiền khi admin sửa Setting sau này.
  bankSnapshot Json?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Shipping {
  id             String    @id @default(cuid())
  orderId        String    @unique
  carrier        String?
  trackingNumber String?
  fee            Decimal   @default(0) @db.Decimal(12, 2)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("shippings")
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

/// Review yêu cầu verified purchase: chỉ tạo được khi user có 1 order ở
/// trạng thái DELIVERED chứa sản phẩm này (server tự tìm lại orderId, không
/// tin client) — orderId lưu lại làm bằng chứng đã mua, không cần trỏ tới
/// từng OrderItem cụ thể.
model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  orderId   String
  rating    Int
  comment   String?
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id])

  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Wishlist
// ---------------------------------------------------------------------------

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlists")
}

// ---------------------------------------------------------------------------
// Coupons
// ---------------------------------------------------------------------------

/// Nhóm mã giảm giá (vd "Miễn phí vận chuyển", "Giảm giá sản phẩm") — khách chỉ
/// được áp 1 mã đang hoạt động cho mỗi danh mục trên cùng một đơn hàng (ép buộc ở
/// order.service.ts), nhưng có thể áp đồng thời nhiều mã ở các danh mục khác nhau.
model CouponCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coupons Coupon[]

  @@index([slug])
  @@map("coupon_categories")
}

model Coupon {
  id            String     @id @default(cuid())
  code          String     @unique
  type          CouponType
  value         Decimal    @db.Decimal(12, 2)
  minOrderValue Decimal?   @db.Decimal(12, 2)
  maxDiscount   Decimal?   @db.Decimal(12, 2)
  usageLimit    Int?
  usedCount     Int        @default(0)
  startsAt      DateTime?
  expiresAt     DateTime?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  categoryId String

  category     CouponCategory @relation(fields: [categoryId], references: [id])
  orderCoupons OrderCoupon[]

  @@index([code])
  @@index([categoryId])
  @@map("coupons")
}

// ---------------------------------------------------------------------------
// Settings
// ---------------------------------------------------------------------------

/// Singleton row (fixed id, see SETTINGS_ID in server/utils/shipping.ts) holding
/// site-wide, admin-configurable settings — shipping + payOS bank display info.
model Setting {
  id                    String  @id
  shippingFee           Decimal @default(50000) @db.Decimal(12, 2)
  freeShippingThreshold Decimal @default(500000) @db.Decimal(12, 2)

  /// Tài khoản ngân hàng nhận tiền chuyển khoản (mã QR VietQR dựng trực tiếp từ
  /// các field này, xem app/utils/vietqr.ts) — đổi ở đây đổi luôn nơi tiền chảy
  /// vào cho đơn MỚI. Đơn cũ không bị ảnh hưởng nhờ Payment.bankSnapshot chụp
  /// lại các field này tại thời điểm tạo đơn. bankCode là mã ngân hàng VietQR
  /// (vd "VCB"), chọn từ danh sách GET /api/admin/settings/banks.
  bankTransferEnabled Boolean @default(false)
  bankName            String?
  bankCode            String?
  bankAccountNumber   String?
  bankAccountName     String?

  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Content — blog/news + recipe posts, homepage banners, contact inbox
// ---------------------------------------------------------------------------

model Post {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  excerpt       String?
  content       String
  coverImageUrl String?
  type          PostType
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([slug])
  @@index([type])
  @@index([isPublished])
  @@map("posts")
}

model Banner {
  id        String   @id @default(cuid())
  imageUrl  String?
  title     String?
  subtitle  String?
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buttons BannerButton[]

  @@index([isActive])
  @@map("banners")
}

model BannerButton {
  id       String @id @default(cuid())
  bannerId String
  label    String
  link     String
  position Int    @default(0)

  banner Banner @relation(fields: [bannerId], references: [id], onDelete: Cascade)

  @@index([bannerId])
  @@map("banner_buttons")
}

enum SocialLinkIconType {
  PRESET
  CUSTOM
}

enum SocialLinkDisplay {
  FOOTER
  FIXED
}

enum SocialLinkSize {
  SMALL
  MEDIUM
  LARGE
  XLARGE
  XXLARGE
}

model SocialLink {
  id              String             @id @default(cuid())
  label           String?
  url             String
  iconType        SocialLinkIconType @default(PRESET)
  /// Preset key (e.g. "facebook", "zalo") looked up against SOCIAL_ICON_PRESETS when iconType = PRESET
  iconKey         String?
  /// Uploaded image URL (via /uploads/social-links/...) when iconType = CUSTOM
  imageUrl        String?
  /// FOOTER: shown in the storefront footer row (default). FIXED: shown as a floating button on the right edge of every page.
  displayLocation SocialLinkDisplay  @default(FOOTER)
  /// Rendered icon size, looked up against SOCIAL_ICON_SIZES for the actual pixel classes.
  size            SocialLinkSize     @default(MEDIUM)
  position        Int                @default(0)
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([isActive])
  @@map("social_links")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
  @@map("contact_messages")
}
