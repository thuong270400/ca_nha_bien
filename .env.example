# PostgreSQL connection (database "e_commerce", schema "fiship")
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=YOUR_PASSWORD
DB_DATABASE=e_commerce
DB_SCHEMA=fiship

# Prisma reads this directly. Keep it in sync with the values above.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/e_commerce?schema=fiship"

# Sealed session cookie secret for nuxt-auth-utils (min 32 chars). Generate with:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
NUXT_SESSION_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Cloudflare R2 (S3-compatible object storage) for admin-uploaded images
# (server/utils/r2.ts, server/services/upload.service.ts). The bucket stays
# private — reads are proxied through GET /uploads/[...path].
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=YOUR_BUCKET_NAME

# Public base URL of the site — used for the sitemap.
NUXT_PUBLIC_SITE_URL=https://canhabien.vn

# SePay webhook (auto-confirms BANK_TRANSFER orders, see CLAUDE.md "Payments").
# Webhook URL to configure on SePay's dashboard (Company -> Webhooks):
# https://YOUR_DOMAIN/api/webhooks/sepay
# Set ONE of the two below, matching whatever Security method you pick there
# (server/utils/sepay.ts checks HMAC first, then falls back to API Key) —
# SePay never generates these for you, you paste the same value into SePay's
# dashboard when creating the webhook AND here. Generate either with:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"

# Security -> HMAC-SHA256: the "Secret Key" shown once when the webhook is
# created (SePay signs `${timestamp}.${rawBody}`, sent as header
# X-SePay-Signature: sha256=<hex> + X-SePay-Timestamp).
SEPAY_WEBHOOK_HMAC_SECRET=

# Security -> API Key: sent back as header "Authorization: Apikey <value>".
SEPAY_WEBHOOK_API_KEY=
