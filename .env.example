# PostgreSQL connection (database "e_commerce", schema "fiship")
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=YOUR_PASSWORD
DB_DATABASE=e_commerce
DB_SCHEMA=fiship

# Prisma reads this directly. Keep it in sync with the values above.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/e_commerce?schema=fiship"

# Sealed session cookie secret for nuxt-auth-utils (min 32 chars). Generate with:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
NUXT_SESSION_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Cloudflare R2 (S3-compatible object storage) for admin-uploaded images
# (server/utils/r2.ts, server/services/upload.service.ts). The bucket stays
# private — reads are proxied through GET /uploads/[...path].
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=YOUR_BUCKET_NAME
